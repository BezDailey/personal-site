{
  "name": "personal-site",
  "version": "1.0.0",
  "private": true,
  "description": "Personal portfolio for Jabez Dailey.",
  "scripts": {
    "start": "serve frontend/build --no-clipboard --listen \"tcp://0.0.0.0:${PORT:-3001}\"",
    "dev": "npm --prefix frontend start",
    "build": "npm --prefix frontend run build",
    "test": "npm --prefix frontend test -- --watchAll=false",
    "heroku-postbuild": "npm ci --prefix frontend && npm run build"
  },
  "dependencies": {
    "serve": "^14.2.1"
  },
  "license": "ISC",
  "engines": {
    "node": "20.8.1"
  }
}
